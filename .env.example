# Copiar a .env (no se sube a git) y completar con los valores de la conexion Athena de DBeaver
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=            # solo si son credenciales temporales
AWS_REGION=us-east-1
ATHENA_WORKGROUP=primary
ATHENA_OUTPUT_S3=s3://bucket-resultados/carpeta/

# SAP Business One Service Layer (SPEC-30): SOLO LECTURA, solo desde la red de Pesco.
# Pedir los valores a TI. Nunca poner la IP, el usuario ni la clave en el repositorio.
SAP_SL_URL=https://<host>:50000/b1s/v1
SAP_SL_USER=
SAP_SL_PASSWORD=
SAP_SL_COMPANY=X_CHILE_PRUEBAS          # base de pruebas indicada por TI
# SAP_SL_BASES_PRUEBA=X_CHILE_PRUEBAS   # bases que se aceptan sin permiso de produccion
# SAP_SL_PERMITIR_PRODUCCION=0          # 1 solo con acuerdo de TI
SAP_SL_CA_BUNDLE=                       # ruta al certificado del servidor (lo entrega TI)
# SAP_SL_VERIFICAR_TLS=1                # 0 desactiva la verificacion: NO recomendado (la clave viaja por internet)
# Limites de carga (por defecto): pausa 0.5 s, pagina 100 filas, 300 peticiones por corrida,
# 30 s de timeout; corta tras 3 respuestas de mas de 15 s o 3 errores seguidos.
# SAP_SL_PAUSA=0.5
# SAP_SL_PAGINA=100
# SAP_SL_MAX_PETICIONES=300
# SAP_SL_TIMEOUT=30
# SAP_SL_LENTO=15
